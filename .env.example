# campus-assistant environment variables — copy to .env and edit as needed.
# All variables are optional; defaults are shown.

# Directory where the database, files, and browser profile are stored.
# CAMPUS_DATA_DIR=~/.local/share/campus-assistant

# Comma-separated Brightspace hostnames to sync.
# CAMPUS_BS_HOSTS=splms.polite.edu.sg,lms.polite.edu.sg

# Regex of course names to skip entirely (e.g. "COVID-19|WSH").
# CAMPUS_BS_SKIP=

# Delay in seconds between Brightspace requests (throttle).
# CAMPUS_BS_DELAY=0.25

# Chromium channel for Playwright: empty = bundled Chromium, or "chrome" / "msedge".
# CAMPUS_BROWSER_CHANNEL=

# How often the background service syncs, in minutes.
# CAMPUS_SYNC_INTERVAL_MIN=60

# Maximum file size to extract text from, in MB.
# CAMPUS_MAX_FILE_MB=50

# API server bind address and port.
# CAMPUS_API_HOST=127.0.0.1
# CAMPUS_API_PORT=8765

# Set to "0" to disable automatic LLM analysis after each sync.
# CAMPUS_AUTO_ANALYZE=1

# Path to the built web UI (web/dist). Only needed if overriding the default.
# CAMPUS_WEB_DIST=
